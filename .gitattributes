# Keep repository source, workflow, and documentation text consistent across platforms.
# This intentionally avoids a broad `* text=auto` rule and does not renormalize existing files.
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
